[Unit]
Description=RTS proxy — OpenAI endpoint doing search + cross-model retrieve-then-solve
After=llama-server.service a3b-extractor.service
Wants=llama-server.service a3b-extractor.service

[Service]
Type=exec
Environment=RTS_PORT=8090
Environment=ANSWER_ENDPOINT=http://127.0.0.1:8080
Environment=EXTRACT_ENDPOINT=http://127.0.0.1:18094
Environment=SEARCH_MODE=auto
Environment=ANSWER_THINK=medium
Environment=MAX_DOC_CHARS=1200
EnvironmentFile=%h/.config/rts-proxy.env
ExecStart=/usr/bin/python3 -u %HOME%/rts-proxy/rts_proxy.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
